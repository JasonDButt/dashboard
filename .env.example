# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored; never commit real keys.

# Supabase -> Project Settings -> API (or "API Keys")
# Just the project URL: no /rest/v1/ on the end (supabase-js adds that itself).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Use the SECRET key (sb_secret_...) or the legacy service_role key.
# It stays on the server: no NEXT_PUBLIC_ prefix, ever.
SUPABASE_SECRET_KEY=

# Single login for the whole dashboard (browser username/password prompt).
DASHBOARD_USER=me
DASHBOARD_PASSWORD=

# Used for "today" / "worked today". Defaults to Australia/Sydney.
DASHBOARD_TIME_ZONE=Australia/Sydney
